# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible). Confirm the base URL in the Token Factory console.
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
TOKEN_FACTORY_API_KEY=

# Copy the exact model IDs from the Token Factory console.
MODEL_FAST=                    # Nemotron 3 Nano model ID
MODEL_REASONING=               # Nemotron 3 Ultra model ID
MODEL_BALANCED=                # Nemotron 3 Super model ID: writes answers from looked-up sources (optional)

TAVILY_API_KEY=

# Public address of the app (contact URL in push notifications). Optional.
PUBLIC_BASE_URL=

# Signs session cookies. At least 32 chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
COOKIE_SECURE=false            # set true when served over HTTPS
GUEST_TTL_DAYS=7               # guest accounts and their data are deleted after this
GUEST_ULTRA_PER_DAY=10         # "Think harder" (Ultra) turns per guest per day
# Daily limits that protect a public demo's credits (0 = unlimited). Reset at midnight UTC.
GUEST_MESSAGES_PER_DAY=30
USER_MESSAGES_PER_DAY=100
SITE_MESSAGES_PER_DAY=300
SITE_TAVILY_CREDITS_PER_DAY=60  # Tavily's free plan is 1,000 credits a month
DATA_DIR=./data

# Optional: cache identical LLM and search calls on disk during development.
CACHE_ENABLED=true
CACHE_DIR=./.cache

# Execution sandbox for running skill/agent code: local (dev only, not a security boundary) | daytona
SANDBOX_BACKEND=local
DAYTONA_API_KEY=

# Shared secret for the daily scheduled job (POST /internal/recalls/run, header X-Lantern-Cron). Empty = job disabled
CRON_SECRET=

# Push notifications ("Alert me on this phone"). Generate with: python -m app.push  (empty = notifications off)
VAPID_PRIVATE_KEY=
